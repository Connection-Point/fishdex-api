# Paste into Vercel → Project → Settings → Environment Variables (Production).
# The Dockerfile already sets: APP_ENV, APP_DEBUG, LOG_CHANNEL, CACHE_STORE, SESSION_DRIVER,
# QUEUE_CONNECTION=sync, FISHDEX_INLINE_SCANS=true, TRUSTED_PROXIES, MEDIA_DRIVER/ASSETS_DRIVER=s3, MYSQL_ATTR_SSL_CA.

APP_NAME=FishDex
APP_KEY=base64:...                      # php artisan key:generate --show  (keep it stable; never commit)
APP_URL=https://fishdex-api.vercel.app  # your real Vercel domain
SESSION_SECURE_COOKIE=true

# TiDB Cloud (Starter) → Connect → "General" connection
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=fishdex
DB_USERNAME=xxxxxxxx.root
DB_PASSWORD=

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=fishdex-media-private
R2_ASSETS_BUCKET=fishdex-assets-public
ASSETS_CDN_URL=https://pub-xxxxxxxx.r2.dev   # public URL of the assets bucket

# AI (free tier)
AI_TIER=free
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
AI_FREE_RPM=10
AI_FREE_RPD=250

# Auth / app
GOOGLE_CLIENT_IDS=
FISHDEX_MIN_APP_VERSION=1.0.0
ADMIN_REQUIRE_MFA=true
MAIL_MAILER=log

# Vercel Cron sends this as "Authorization: Bearer ..." to /internal/cron/daily
CRON_SECRET=                            # any long random string
