# Copy to fishdex-api/.env.tidb (git-ignored) and run artisan against TiDB/R2 from your PC:
#   php artisan migrate --seed --force --env=tidb
#   php artisan fishdex:create-admin you@example.com --name="You" --env=tidb
#   php artisan fishdex:import-card-art --env=tidb
APP_NAME=FishDex
APP_ENV=production
APP_KEY=base64:...                      # SAME key as on Vercel
APP_URL=https://fishdex-api.vercel.app

DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=fishdex
DB_USERNAME=xxxxxxxx.root
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=C:\laragon\etc\ssl\cacert.pem   # TiDB requires TLS

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync
FISHDEX_INLINE_SCANS=true

MEDIA_DRIVER=s3
ASSETS_DRIVER=s3
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=fishdex-media-private
R2_ASSETS_BUCKET=fishdex-assets-public
ASSETS_CDN_URL=https://pub-xxxxxxxx.r2.dev
