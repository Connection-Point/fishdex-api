# ---------------------------------------------------------------
# FishDex API (Laravel) — .gitignore
# ---------------------------------------------------------------

# Dependencies (restored by `composer install`)
/vendor
/node_modules

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
/auth.json
/storage/*.key
# Firebase / Google service-account keys (FIREBASE_CREDENTIALS)
*firebase*credentials*.json
*service-account*.json
/storage/app/firebase/

# Local databases & runtime data
/database/*.sqlite
/database/*.sqlite-journal
/storage/pail
/public/storage
/public/hot
/public/build
/public/fonts-manifest.dev.json

# Filament assets — regenerated by `php artisan filament:upgrade` (runs after composer install)
/public/css/filament
/public/js/filament
/public/fonts/filament

# Docker volumes / local overrides
/compose.override.yaml
/docker-data

# Test & tooling caches
/.phpunit.cache
.phpunit.result.cache
/coverage
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php
.phpactor.json

# AI evaluation image sets (can be large / licensed — keep out of git)
/storage/eval
/eval-data

# Logs
*.log

# IDEs & editors
/.idea
/.vscode
/.zed
/.nova
/.fleet
/.cursor
/.codex
*.swp

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Homestead
Homestead.json
Homestead.yaml
