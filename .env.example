APP_NAME=FishDex
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# --- Database (MySQL 8 / MariaDB 10.11+) -------------------------------------
# For a zero-setup first run you can use DB_CONNECTION=sqlite instead.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fishdex
DB_USERNAME=fishdex
DB_PASSWORD=secret

# --- Redis: cache, queues, rate limits, AI capacity counters -----------------
# Use "database" for both if Redis isn't running locally yet.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@fishdex.app"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage (doc 09) -------------------------------------------------------
# local = storage/app (dev). s3 = Cloudflare R2 via the S3 API (staging/prod).
MEDIA_DRIVER=local
ASSETS_DRIVER=local
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_MEDIA_BUCKET=fishdex-media-private
R2_ASSETS_BUCKET=fishdex-assets-public
ASSETS_CDN_URL=https://cdn.fishdex.app

# --- AI identification (doc 08) ---------------------------------------------
# AI_TIER=free uses the Gemini API free tier (closed beta, D-16).
# AI_PROVIDER=fake gives deterministic results with no API calls (local dev).
AI_TIER=free
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=
GEMINI_API_KEY=
# Copy the exact model ID from Google AI Studio.
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
GEMINI_RERANK_MODEL=
GEMINI_TIMEOUT=30
# Optional, e.g. {"thinkingLevel":"low"} — thinking tokens are billed as output.
GEMINI_THINKING_CONFIG=null
# Enter the numbers shown on AI Studio's rate-limit page for your project.
AI_FREE_RPM=10
AI_FREE_RPD=250
AI_PAID_RPM=500
AI_DAILY_BUDGET_USD=20

# --- FishDex ----------------------------------------------------------------
FISHDEX_DEFAULT_COUNTRY=MY
FISHDEX_DEFAULT_CARD_SET=MY-S1
FISHDEX_MIN_APP_VERSION=1.0.0
FISHDEX_FREE_DAILY_SCANS=5
ADMIN_REQUIRE_MFA=true

# --- Google Sign-In: comma-separated OAuth client IDs (Android + web) --------
GOOGLE_CLIENT_IDS=

# --- Firebase Cloud Messaging (push "scan finished") ------------------------
# Path to the service-account JSON. Leave empty to disable push (polling still works).
FIREBASE_CREDENTIALS=
